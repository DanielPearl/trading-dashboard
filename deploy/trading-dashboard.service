[Unit]
Description=Kalshi multi-bot trading dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-dashboard
# Load KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_PATH so the dashboard can
# fetch live candlesticks for each bot's series. We piggyback on the
# gas-prices bot's .env — same key, read-only use, no scope expansion.
# `-` prefix makes systemd skip the line if the file is missing
# (e.g. on a fresh droplet that hasn't installed gas-prices yet).
EnvironmentFile=-/root/gas-prices/.env
ExecStart=/root/trading-dashboard/.venv/bin/python /root/trading-dashboard/dashboard.py --config /root/trading-dashboard/config/dashboard.yaml
# Memory caps. Original was 80M/60M (sized for a render-only
# dashboard). Each folded-in bot adds:
#   * one-time: pandas/sklearn/xgboost imports (~115M, shared)
#   * per-bot: model artifact (1–10MB, 81M for billboard)
#   * per-bot: cached DataFrames (10–40MB)
# With all 10 bots folded in we project ~350–450M resident.
# 500M cap gives headroom; soft cap at 400M flags pressure.
MemoryMax=500M
MemoryHigh=400M
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
