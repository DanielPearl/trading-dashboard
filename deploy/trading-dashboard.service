[Unit]
Description=Kalshi multi-bot trading dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-dashboard
# Load KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_PATH so the dashboard can
# fetch live candlesticks for each bot's series. We piggyback on the
# gas-prices bot's .env — same key, read-only use, no scope expansion.
# `-` prefix makes systemd skip the line if the file is missing
# (e.g. on a fresh droplet that hasn't installed gas-prices yet).
EnvironmentFile=-/root/gas-prices/.env
ExecStart=/root/trading-dashboard/.venv/bin/python /root/trading-dashboard/dashboard.py --config /root/trading-dashboard/config/dashboard.yaml
# Memory caps raised from the original 80M/60M to accommodate the
# in-process tennis trader (and subsequent bots that get folded in).
# The 80M cap was sized for a render-only dashboard; once we import
# pandas + sklearn + joblib for the tennis bundle the resident set
# climbs to ~150–180M average, ~220M during model load. 250M gives
# headroom for the next bot we fold in without another bump.
MemoryMax=250M
MemoryHigh=200M
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
