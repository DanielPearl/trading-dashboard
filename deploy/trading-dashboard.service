[Unit]
Description=Kalshi multi-bot trading dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-dashboard
# Load KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_PATH so the dashboard can
# fetch live candlesticks for each bot's series. We piggyback on the
# gas-prices bot's .env — same key, read-only use, no scope expansion.
# `-` prefix makes systemd skip the line if the file is missing
# (e.g. on a fresh droplet that hasn't installed gas-prices yet).
EnvironmentFile=-/root/gas-prices/.env
ExecStart=/root/trading-dashboard/.venv/bin/python /root/trading-dashboard/dashboard.py --config /root/trading-dashboard/config/dashboard.yaml
# Memory caps. Sized for the droplet's actual 2GB RAM (the hostname
# label still says "512mb" from when the droplet was first created,
# but it was resized). The previous 500M/400M caps were leftovers
# from when I mis-read the hostname tag — they forced the kernel
# to page the dashboard out to swap even though ~1.2 GiB of system
# RAM was sitting idle. Bumping to 1500M / 1200M lets the dashboard
# use the RAM it has access to, with headroom for billboard's
# 81MB lazy model load and slow DataFrame growth over weeks.
MemoryMax=1500M
MemoryHigh=1200M
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
