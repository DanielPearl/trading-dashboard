[Unit]
Description=Kalshi multi-bot trading dashboard (SIM — paper trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-dashboard
# Load KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_PATH so the dashboard can
# fetch live candlesticks for each bot's series. We piggyback on the
# gas-prices bot's .env — same key, read-only use, no scope expansion.
# `-` prefix makes systemd skip the line if the file is missing
# (e.g. on a fresh droplet that hasn't installed gas-prices yet).
EnvironmentFile=-/root/gas-prices/.env
ExecStart=/root/trading-dashboard/.venv/bin/python /root/trading-dashboard/dashboard.py --config /root/trading-dashboard/config/dashboard.yaml
# Memory caps sized for the droplet's actual 2GB RAM. 1500M cap with
# soft 1200M trigger leaves room for billboard's 81MB lazy model load
# + slow DataFrame growth over weeks. See git log for the history of
# why we landed here (the hostname tag still says "512mb").
MemoryMax=1500M
MemoryHigh=1200M
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
